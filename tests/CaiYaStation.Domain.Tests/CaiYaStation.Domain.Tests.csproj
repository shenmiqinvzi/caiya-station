<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <DuckovPath Condition="'$(DuckovPath)' == ''">E:\Steam\steamapps\common\Escape from Duckov</DuckovPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\CaiYaStation.Domain\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DuckovPath)\Duckov_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\mod\config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\mod\station-layout.json" Link="station-layout.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
